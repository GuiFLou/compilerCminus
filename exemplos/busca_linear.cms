/* Le um vetor, procura um valor e imprime seu indice. */

void main(void)
{
    int valores[6];
    int procurado;
    int encontrado;
    int i;
    i = 0;
    while (i < 6) {
        valores[i] = input();
        i = i + 1;
    }
    procurado = input();
    encontrado = 0 - 1;
    i = 0;
    while (i < 6) {
        if (valores[i] == procurado) {
            encontrado = i;
        }
        i = i + 1;
    }
    output(encontrado);
}
