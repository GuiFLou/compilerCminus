  0: (GOTO, main, -, -)
  1: (FUN, void, main, -)
  2: (ALLOC, x, main, -)
  3: (ALLOC, y, main, -)
  4: (CALL_I, -, -, t0)
  5: (STORE, t0, -, x)
  6: (CALL_I, -, -, t1)
  7: (STORE, t1, -, y)
  8: (LOAD, x, -, t2)
  9: (LOAD, y, -, t3)
 10: (ADD, t2, t3, t4)
 11: (PARAM, t4, -, -)
 12: (CALL_O, t4, -, -)
 13: (END, main, -, -)
 14: (HALT, -, -, -)
