/* Calcula base elevada ao expoente por multiplicacoes sucessivas. */

void main(void)
{
    int base;
    int expoente;
    int resultado;
    int i;
    base = input();
    expoente = input();
    resultado = 1;
    i = 0;
    while (i < expoente) {
        resultado = resultado * base;
        i = i + 1;
    }
    output(resultado);
}
