  0: (GOTO, main, -, -)
  1: (FUN, void, main, -)
  2: (ALLOC, x, main, -)
  3: (ALLOC, y, main, -)
  4: (CALL_I, -, -, t0)
  5: (STORE, t0, -, x)
  6: (CALL_I, -, -, t1)
  7: (STORE, t1, -, y)
  8: (LOAD, x, -, t2)
  9: (LOAD, y, -, t3)
 10: (SLT, t3, t2, t4)
 11: (IFF, t4, L0, -)
 12: (LOAD, x, -, t5)
 13: (PARAM, t5, -, -)
 14: (CALL_O, t5, -, -)
 15: (GOTO, L1, -, -)
 16: (LAB, L0, -, -)
 17: (LOAD, y, -, t6)
 18: (PARAM, t6, -, -)
 19: (CALL_O, t6, -, -)
 20: (LAB, L1, -, -)
 21: (END, main, -, -)
 22: (HALT, -, -, -)
