/* Calcula a media inteira de cinco valores informados pelo usuario. */

void main(void)
{
    int valores[5];
    int soma;
    int i;
    int media;
    soma = 0;
    i = 0;
    while (i < 5) {
        valores[i] = input();
        soma = soma + valores[i];
        i = i + 1;
    }
    media = soma / 5;
    output(media);
}
