/* Procura o valor 9 em um vetor e imprime seu indice. */

void main(void)
{
    int valores[6];
    int procurado;
    int encontrado;
    int i;
    valores[0] = 4;
    valores[1] = 7;
    valores[2] = 2;
    valores[3] = 9;
    valores[4] = 5;
    valores[5] = 1;
    procurado = 9;
    encontrado = 0 - 1;
    i = 0;
    while (i < 6) {
        if (valores[i] == procurado) {
            encontrado = i;
        }
        i = i + 1;
    }
    output(encontrado);
}
